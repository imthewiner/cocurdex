{
  "expo": {
    "name": "Cocurdex",
    "slug": "cocurdex",
    "scheme": "cocurdex",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "dev.cocurdex.mobile",
      "supportsTablet": false,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSLocalNetworkUsageDescription": "Cocurdex connects to the computers you pair on your local network.",
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "dev.cocurdex.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-secure-store",
      "expo-router",
      [
        "expo-localization",
        {
          "supportedLocales": ["en", "zh-Hans"]
        }
      ]
    ],
    "locales": {
      "zh-Hans": "./native-locales/zh-Hans.json"
    }
  }
}
